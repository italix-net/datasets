{
    "name": "italix/datasets",
    "description": "Server-side data tables and trees: column and action definitions in PHP, driver-rendered client configuration, whitelisted column names",
    "type": "library",
    "version": "2.1.1",
    "keywords": [
        "datatable",
        "datatree",
        "tabulator",
        "grid",
        "table",
        "tree",
        "hierarchical",
        "server-side",
        "pagination",
        "sorting"
    ],
    "homepage": "https://github.com/italix-net/datasets",
    "license": "MPL-2.0",
    "authors": [
        {
            "name": "Italix",
            "email": "info@italix.net"
        }
    ],
    "support": {
        "issues": "https://github.com/italix-net/datasets/issues",
        "source": "https://github.com/italix-net/datasets"
    },
    "require": {
        "php": ">=7.4",
        "italix/contracts": "^2.0"
    },
    "require-dev": {
        "italix/testing": "^2.0",
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "Italix\\DataSets\\": ""
        },
        "files": [
            "functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Italix\\DataSets\\Tests\\PHPUnit\\": "tests/PHPUnit/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "php tests/DataSetTest.php",
            "php tests/ServerSideRequestTest.php",
            "php tests/ServerSideResponseTest.php",
            "php tests/ActionsTest.php"
        ],
        "test-phpunit": "phpunit"
    }
}
